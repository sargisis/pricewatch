DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricewatch
JWT_SECRET=change-me-to-a-long-random-string
BIND_ADDR=0.0.0.0:3000
# How often each product is re-checked.
CHECK_INTERVAL_SECS=3600
# How often the scheduler looks for products that are due.
SCHEDULER_TICK_SECS=60
SCRAPE_CONCURRENCY=4
# Optional: Slack/Discord-compatible webhook for price alerts.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
RUST_LOG=pricewatchproject=info,tower_http=info
# Folder with the built frontend (npm run build). Served if it exists.
# STATIC_DIR=../frontend/dist
